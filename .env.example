# Copy this file to .env and fill in your values. Never commit .env itself.

# Get this from https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional but recommended during development: your test server's ID.
# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID.
# Commands sync instantly to this one server instead of taking up to an hour globally.
GUILD_ID=

# Timezone used for scheduling (IANA name). Defaults to America/Chicago if unset.
BOT_TIMEZONE=America/Chicago
